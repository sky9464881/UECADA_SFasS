        "func": "return buildCommonSensorMessages(msg);\n\nfunction buildCommonSensorMessages(msg) {\n    const payload = msg.payload;\n    const sensors = Array.isArray(payload.sensors) ? payload.sensors : [];\n    const lineId = payload.line.line_id;\n    const equipmentId = payload.equipment.equipment_id;\n    const equipmentType = payload.equipment.equipment_type;\n    const instanceId = payload.equipment.instance_id;\n    const base = {\n        timestamp: payload.timestamp,\n        line_id: lineId,\n        equipment_id: equipmentId,\n        equipment_type: equipmentType,\n        instance_id: instanceId,\n        operation: payload.operation,\n        sample: payload.sample\n    };\n    const prefix = `das/common/${lineId}/${equipmentId}`;\n    const byId = Object.fromEntries(sensors.map(sensor => [sensor.sensor_id, sensor]));\n    const messages = [];\n    if (byId['VIB-01']) {\n        messages.push({ topic: `${prefix}/vibration/window`, payload: { ...base, sensor_id: 'VIB-01', window: byId['VIB-01'].window, values: byId['VIB-01'].values, unit: byId['VIB-01'].unit } });\n    }\n    if (byId['CUR-01']) {\n        messages.push({ topic: `${prefix}/current`, payload: { ...base, sensor_id: 'CUR-01', sample: byId['CUR-01'].sample, value: byId['CUR-01'].values.current, unit: byId['CUR-01'].unit } });\n    }\n    if (byId['VOLT-01']) {\n        messages.push({ topic: `${prefix}/voltage`, payload: { ...base, sensor_id: 'VOLT-01', sample: byId['VOLT-01'].sample, values: byId['VOLT-01'].values, unit: byId['VOLT-01'].unit } });\n    }\n    if (byId['TEMP-01']) {\n        messages.push({ topic: `${prefix}/temperature`, payload: { ...base, sensor_id: 'TEMP-01', sample: byId['TEMP-01'].sample, value: byId['TEMP-01'].values.equipment_temperature, unit: byId['TEMP-01'].unit } });\n    }\n    return [messages];\n}\n",
