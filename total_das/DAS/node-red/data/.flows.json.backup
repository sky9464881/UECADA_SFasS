[
    {
        "id": "das_tab_router",
        "type": "tab",
        "label": "DAS MQTT Router",
        "disabled": false,
        "info": "Receives simulator windows and routes them to 27 equipment instance inputs."
    },
    {
        "id": "das_tab_line_01",
        "type": "tab",
        "label": "LINE-01 equipment",
        "disabled": false,
        "info": "One input per equipment instance. Publishes vibration/current/voltage/temperature messages."
    },
    {
        "id": "das_tab_line_02",
        "type": "tab",
        "label": "LINE-02 equipment",
        "disabled": false,
        "info": "One input per equipment instance. Publishes vibration/current/voltage/temperature messages."
    },
    {
        "id": "das_tab_line_03",
        "type": "tab",
        "label": "LINE-03 equipment",
        "disabled": false,
        "info": "One input per equipment instance. Publishes vibration/current/voltage/temperature messages."
    },
    {
        "id": "das_tab_collector_opcua",
        "type": "tab",
        "label": "DAS Collector OPC UA",
        "disabled": false,
        "info": "Collects all das/common MQTT sensor streams and exposes the latest DAS values through an OPC UA server."
    },
    {
        "id": "das_mqtt_broker",
        "type": "mqtt-broker",
        "name": "mosquitto:1883",
