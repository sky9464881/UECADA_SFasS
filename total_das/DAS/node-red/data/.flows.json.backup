    {
        "id": "das_opcua_track_init",
        "type": "function",
        "z": "das_tab_collector_opcua",
        "name": "track OPC UA variable init",
        "func": "const payload = msg.payload || {};\nconst expected = flow.get('das_opcua_expected_variables') || 324;\nconst created = flow.get('das_opcua_created_variables') || {};\n\nif (payload.nodeId && payload.variableName) {\n    const variableName = String(payload.variableName).replace(/^\\d+:/, '');\n    if (variableName.startsWith('DAS_')) {\n        created[variableName] = true;\n        flow.set('das_opcua_created_variables', created);\n    }\n}\n\nconst count = Object.keys(created).length;\nif (count >= expected) {\n    flow.set('das_opcua_ready', true);\n    node.status({ fill: 'green', shape: 'dot', text: `${count}/${expected} OPC UA variables ready` });\n} else {\n    flow.set('das_opcua_ready', false);\n    node.status({ fill: 'yellow', shape: 'ring', text: `${count}/${expected} OPC UA variables ready` });\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "flow.set('das_opcua_ready', false);\nflow.set('das_opcua_created_variables', {});",
        "finalize": "",
