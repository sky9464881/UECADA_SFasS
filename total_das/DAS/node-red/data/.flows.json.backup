        "func": "msg.payload = summarize(msg.payload);\nreturn msg;\n\nfunction summarize(payload) {\n    const summary = {\n        topic: msg.topic,\n        line_id: payload.line_id,\n        equipment_id: payload.equipment_id,\n        equipment_type: payload.equipment_type,\n        instance_id: payload.instance_id,\n        sensor_id: payload.sensor_id\n    };\n    if (payload.sensor_id === 'VIB-01') {\n        const values = payload.values || {};\n        const window = payload.window || {};\n        summary.vibration_rms = values.vibration_rms;\n        summary.sample_rate_hz = window.sample_rate_hz;\n        summary.window_size = window.window_size || window.sample_count;\n        summary.stride = window.stride;\n        summary.raw_length = Array.isArray(values.vibration_raw) ? values.vibration_raw.length : 0;\n        summary.model_input_key = window.model_input ? window.model_input.input_key : undefined;\n    } else {\n        summary.value = payload.value;\n        summary.values = payload.values;\n        summary.unit = payload.unit;\n    }\n    return summary;\n}\n",
