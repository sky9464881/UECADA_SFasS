    {
        "id": "das_collector_note",
        "type": "comment",
        "z": "das_tab_collector_opcua",
        "name": "DAS collector: subscribes to das/common/# and exposes scalar values through OPC UA at opc.tcp://localhost:53880/UA/DAS/",
        "info": "The flow keeps the latest value per line/equipment/sensor in flow context and updates OPC UA variables. Raw vibration arrays are intentionally not exposed by default; set SEND_RAW_VIBRATION_TO_OPCUA to true in the collector function if an OPC UA Double Array is required.",
        "x": 480,
        "y": 40,
        "wires": []
    },
    {
        "id": "das_opcua_init_inject",
        "type": "inject",
        "z": "das_tab_collector_opcua",
        "name": "initialize OPC UA variables",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "30",
        "crontab": "",
        "once": true,
        "onceDelay": "8",
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 170,
        "y": 100,
        "wires": [
            [
                "das_opcua_init_vars"
            ]
        ]
    },
    {
        "id": "das_opcua_init_vars",
        "type": "function",
        "z": "das_tab_collector_opcua",
        "name": "build OPC UA variable list",
        "func": "const lines = ['LINE-01', 'LINE-02', 'LINE-03'];\nconst equipment = ['CAST-01', 'CNC-01', 'CNC-02', 'CNC-03', 'WASH-01', 'ASSY-01', 'ASSY-02', 'TEST-01', 'TEST-02'];\nconst points = [\n    ['vibration_rms', 'Double', 0],\n    ['vibration_sample_rate_hz', 'Double', 0],\n    ['vibration_window_size', 'Double', 0],\n    ['vibration_stride', 'Double', 0],\n    ['vibration_raw_length', 'Double', 0],\n    ['current_a', 'Double', 0],\n    ['voltage_v', 'Double', 0],\n    ['control_voltage_v', 'Double', 0],\n    ['equipment_temperature_c', 'Double', 0],\n    ['operation_state', 'String', 'UNKNOWN'],\n    ['health_state', 'String', 'UNKNOWN'],\n    ['updated_at', 'String', '']\n];\n\nfunction clean(value) {\n    return String(value).replace(/[^A-Za-z0-9_]/g, '_');\n}\n\nconst expected = lines.length * equipment.length * points.length;\nflow.set('das_opcua_expected_variables', expected);\n\nif (flow.get('das_opcua_ready') === true) {\n    node.status({ fill: 'green', shape: 'dot', text: `${expected}/${expected} OPC UA variables ready` });\n    return null;\n}\n\nconst created = flow.get('das_opcua_created_variables') || {};\nconst messages = [];\nfor (const line of lines) {\n    for (const item of equipment) {\n        for (const [point, datatype] of points) {\n            const variableName = `DAS_${clean(line)}_${clean(item)}_${point}`;\n            if (created[variableName]) {\n                continue;\n            }\n            messages.push({\n                topic: `ns=1;s=${variableName};datatype=${datatype};browseName=${variableName}`,\n                payload: { opcuaCommand: 'addVariable' }\n            });\n        }\n    }\n}\n\nnode.status({ fill: messages.length ? 'yellow' : 'green', shape: 'dot', text: `${Object.keys(created).length}/${expected} ready, ${messages.length} init messages` });\nreturn messages.length ? [messages] : null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 100,
        "wires": [
            [
                "das_opcua_server"
            ]
        ]
    },
    {
        "id": "das_collector_mqtt_in",
        "type": "mqtt in",
        "z": "das_tab_collector_opcua",
        "name": "all common sensor streams",
        "topic": "das/common/#",
        "qos": "0",
        "datatype": "auto",
        "broker": "das_mqtt_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 220,
        "wires": [
            [
                "das_collector_json_parse"
            ]
        ]
    },
    {
        "id": "das_collector_json_parse",
        "type": "json",
        "z": "das_tab_collector_opcua",
        "name": "parse common JSON",
        "property": "payload",
        "action": "",
        "pretty": false,
        "x": 390,
        "y": 220,
        "wires": [
            [
                "das_collector_collect_and_update"
            ]
        ]
    },
    {
        "id": "das_collector_collect_and_update",
        "type": "function",
        "z": "das_tab_collector_opcua",
        "name": "collect DAS and update OPC UA",
        "func": "const EXPECTED_EQUIPMENT = 27;\nconst SEND_RAW_VIBRATION_TO_OPCUA = false;\nconst payload = msg.payload || {};\nconst topicParts = String(msg.topic || '').split('/');\nconst lineId = payload.line_id || topicParts[2];\nconst equipmentId = payload.equipment_id || topicParts[3];\nconst sensorId = payload.sensor_id;\n\nif (!lineId || !equipmentId || !sensorId) {\n    return [null, null];\n}\n\nfunction clean(value) {\n    return String(value).replace(/[^A-Za-z0-9_]/g, '_');\n}\n\nfunction variableName(point) {\n    return `DAS_${clean(lineId)}_${clean(equipmentId)}_${point}`;\n}\n\nfunction numeric(value) {\n    const number = Number(value);\n    return Number.isFinite(number) ? number : null;\n}\n\nfunction update(point, value, datatype = 'Double') {\n    if (value === undefined || value === null) {\n        return null;\n    }\n    const variableValue = datatype === 'String' ? String(value) : numeric(value);\n    if (variableValue === null) {\n        return null;\n    }\n    return {\n        topic: variableName(point),\n        payload: {\n            messageType: 'Variable',\n            namespace: 1,\n            variableName: variableName(point),\n            variableValue,\n            datatype\n        }\n    };\n}\n\nconst latest = flow.get('das_latest') || {};\nconst equipmentKey = `${lineId}.${equipmentId}`;\nconst item = latest[equipmentKey] || {\n    line_id: lineId,\n    equipment_id: equipmentId,\n    equipment_type: payload.equipment_type,\n    instance_id: payload.instance_id,\n    points: {}\n};\n\nitem.line_id = lineId;\nitem.equipment_id = equipmentId;\nitem.equipment_type = payload.equipment_type || item.equipment_type;\nitem.instance_id = payload.instance_id || item.instance_id;\nitem.updated_at = payload.timestamp || new Date().toISOString();\n\nconst values = payload.values || {};\nconst window = payload.window || {};\nconst writes = [];\n\nfunction add(point, value, datatype = 'Double') {\n    const write = update(point, value, datatype);\n    if (write) {\n        writes.push(write);\n        item.points[point] = datatype === 'String' ? String(value) : numeric(value);\n    }\n}\n\nadd('operation_state', payload.operation && payload.operation.state, 'String');\nadd('health_state', payload.operation && payload.operation.health, 'String');\nadd('updated_at', item.updated_at, 'String');\n\nif (sensorId === 'VIB-01') {\n    add('vibration_rms', values.vibration_rms);\n    add('vibration_sample_rate_hz', window.sample_rate_hz);\n    add('vibration_window_size', window.window_size || window.sample_count);\n    add('vibration_stride', window.stride);\n    add('vibration_raw_length', Array.isArray(values.vibration_raw) ? values.vibration_raw.length : 0);\n    if (SEND_RAW_VIBRATION_TO_OPCUA && Array.isArray(values.vibration_raw)) {\n        writes.push({\n            topic: variableName('vibration_raw'),\n            payload: {\n                messageType: 'Variable',\n                namespace: 1,\n                variableName: variableName('vibration_raw'),\n                variableValue: values.vibration_raw,\n                datatype: 'Double Array'\n            }\n        });\n    }\n} else if (sensorId === 'CUR-01') {\n    add('current_a', payload.value ?? values.current);\n} else if (sensorId === 'VOLT-01') {\n    add('voltage_v', values.voltage);\n    add('control_voltage_v', values.control_voltage);\n} else if (sensorId === 'TEMP-01') {\n    add('equipment_temperature_c', payload.value ?? values.equipment_temperature);\n}\n\nlatest[equipmentKey] = item;\nflow.set('das_latest', latest);\n\nconst equipmentCount = Object.keys(latest).length;\nconst pointCount = Object.values(latest).reduce((total, equipment) => total + Object.keys(equipment.points || {}).length, 0);\nconst opcuaReady = flow.get('das_opcua_ready') === true;\nconst expectedVariables = flow.get('das_opcua_expected_variables') || 324;\nconst createdVariables = Object.keys(flow.get('das_opcua_created_variables') || {}).length;\nconst summary = {\n    timestamp: new Date().toISOString(),\n    equipment_count: equipmentCount,\n    expected_equipment_count: EXPECTED_EQUIPMENT,\n    point_count: pointCount,\n    opcua_ready: opcuaReady,\n    opcua_variables_ready: createdVariables,\n    opcua_variables_expected: expectedVariables,\n    last_update: {\n        line_id: lineId,\n        equipment_id: equipmentId,\n        sensor_id: sensorId,\n        opcua_writes: opcuaReady ? writes.length : 0\n    }\n};\n\nif (!opcuaReady) {\n    node.status({ fill: 'yellow', shape: 'ring', text: `collecting, OPC UA init ${createdVariables}/${expectedVariables}` });\n    return [null, { payload: summary }];\n}\n\nnode.status({ fill: equipmentCount >= EXPECTED_EQUIPMENT ? 'green' : 'yellow', shape: 'dot', text: `${equipmentCount}/${EXPECTED_EQUIPMENT} equipment, ${writes.length} writes` });\nreturn [writes.length ? writes : null, { payload: summary }];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 220,
        "wires": [
            [
                "das_opcua_server"
            ],
            [
                "das_collector_summary_debug"
            ]
        ]
    },
