# LINE-01 환경변수 (README §라인 메타 / 포트 정책)
LINE_ID=LINE-01
LINE_DIR=line1
LINE_NUM_SUFFIX=line01
COMPOSE_PROJECT_NAME=equip-sim-line01

# 호스트 포트 (CNC 는 시리얼 — 포트 없음)
PORT_CAST_01=5001
PORT_WASH_01=5021
PORT_ASSY_01=4841
PORT_ASSY_02=4842
PORT_TEST_01=4851
PORT_TEST_02=4852
PORT_NODERED_UI=2880
PORT_DAS_OPCUA=4860

# CNC RTU-over-TCP gateway ports (host-side publish for debug; Node-RED
# inside docker reaches the bridge via serial-bridge:5101/5102/5103).
PORT_CNC_RTU_01=6101
PORT_CNC_RTU_02=6102
PORT_CNC_RTU_03=6103
