# Integration DAS Node-RED image.
# Pulls flows_integration.json into the image at /data/flows.json
# so Node-RED can rename-on-save (avoids EBUSY).
FROM nodered/node-red:4.1.10-22

USER root
RUN cd /usr/src/node-red \
 && npm install --no-fund --no-audit --omit=dev \
      node-red-contrib-opcua

# Build context is the repo root (see ../integration/docker-compose.yml).
ARG FLOW_FILE=integration/flows_integration.json
COPY ${FLOW_FILE} /data/flows.json
RUN chown -R node-red:node-red /data && chmod 0644 /data/flows.json

USER node-red
