    {
        "id": "70639218d44d4c6c",
        "type": "comment",
        "z": "482b7463ca024817",
        "g": "91d60219727f852e",
        "name": "CNC-01 (RTU-over-TCP) cnc-01:5101",
        "info": "LINE-02_CNC-01 — RTU framing on TCP (Moxa NPort 스타일)\nhost = cnc-01:5101\nslave_id=1\nNode-RED clienttype=tcp / tcpType=TELNET (사용자 실측 OK)",
        "x": 350,
