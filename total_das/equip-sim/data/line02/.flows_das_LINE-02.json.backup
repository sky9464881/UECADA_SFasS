    {
        "id": "11894e7608d93c61",
        "type": "function",
        "z": "482b7463ca024817",
        "g": "91d60219727f852e",
        "name": "parse HR0",
        "func": "const r = Array.isArray(msg.payload)\n  ? msg.payload\n  : ((msg.responseBuffer && msg.responseBuffer.data) || []);\n\nfunction s16(v) {\n  v = (v || 0) & 0xFFFF;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\nconst equipmentId = 'CNC-01';\nconst value = s16(r[0]);\n\nflow.set('merge_cnc01_hr0', value);\nflow.set('merge_cnc01_hr0_ts', Date.now());\n\nconst hr2 = flow.get('merge_cnc01_hr2');\nif (hr2 === undefined) return null;\n\nmsg.payload = {\n  equipment_id: equipmentId,\n  tags: {\n    spindle_speed_sp: value,\n    spindle_speed: hr2\n  }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 520,
        "wires": [
            [
                "e2f57683a4f6435c",
                "2b705a5290014017"
            ]
        ]
    },
    {
        "id": "e9ed093d9c79fc74",
        "type": "function",
        "z": "482b7463ca024817",
        "g": "91d60219727f852e",
        "name": "parse HR2",
        "func": "const r = Array.isArray(msg.payload)\n  ? msg.payload\n  : ((msg.responseBuffer && msg.responseBuffer.data) || []);\n\nfunction s16(v) {\n  v = (v || 0) & 0xFFFF;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\nconst equipmentId = 'CNC-01';\nconst value = s16(r[0]);\n\nflow.set('merge_cnc01_hr2', value);\nflow.set('merge_cnc01_hr2_ts', Date.now());\n\nconst hr0 = flow.get('merge_cnc01_hr0');\nif (hr0 === undefined) return null;\n\nmsg.payload = {\n  equipment_id: equipmentId,\n  tags: {\n    spindle_speed_sp: hr0,\n    spindle_speed: value\n  }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 560,
