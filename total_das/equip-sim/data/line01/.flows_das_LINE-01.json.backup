        "name": "parse HR2",
        "func": "const r = Array.isArray(msg.payload)\n  ? msg.payload\n  : ((msg.responseBuffer && msg.responseBuffer.data) || []);\n\nfunction s16(v) {\n  v = (v || 0) & 0xFFFF;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\nconst equipmentId = 'CNC-03';\nconst value = s16(r[0]);\n\nflow.set('merge_cnc03_hr2', value);\nflow.set('merge_cnc03_hr2_ts', Date.now());\n\nconst hr0 = flow.get('merge_cnc03_hr0');\nif (hr0 === undefined) return null;\n\nmsg.payload = {\n  equipment_id: equipmentId,\n  tags: {\n    spindle_speed_sp: hr0,\n    spindle_speed: value\n  }\n};\nreturn msg;",
