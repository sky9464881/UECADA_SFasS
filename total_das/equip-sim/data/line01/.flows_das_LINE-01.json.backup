    {
        "id": "b828b5e621696cd6",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "c8f54098435e95b2",
        "name": "parse HR0",
        "func": "const r = Array.isArray(msg.payload)\n  ? msg.payload\n  : ((msg.responseBuffer && msg.responseBuffer.data) || []);\n\nfunction s16(v) {\n  v = (v || 0) & 0xFFFF;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\nconst equipmentId = 'CNC-03';\nconst value = s16(r[0]);\n\nflow.set('merge_cnc03_hr0', value);\nflow.set('merge_cnc03_hr0_ts', Date.now());\n\nconst hr2 = flow.get('merge_cnc03_hr2');\nif (hr2 === undefined) return null;\n\nmsg.payload = {\n  equipment_id: equipmentId,\n  tags: {\n    spindle_speed_sp: value,\n    spindle_speed: hr2\n  }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
