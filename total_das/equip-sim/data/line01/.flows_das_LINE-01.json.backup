    {
        "id": "comment_cnc01_merge_split",
        "type": "comment",
        "z": "5b220735e29c459d",
        "g": "c8f54098435e95b2",
        "name": "CNC-01 HR0(sim) + HR2(bridge) merge",
        "info": "Read HR0 from simulator and HR2 from local bridge, then merge back into one payload with the old shape.",
        "x": 410,
        "y": 520,
        "wires": []
    },
    {
        "id": "read_cnc01_hr0_sim_merge",
        "type": "modbus-read",
        "z": "5b220735e29c459d",
        "g": "c8f54098435e95b2",
        "name": "CNC-01 HR[0] from sim",
        "topic": "cnc01_hr0",
        "showStatusActivities": false,
        "logIOActivities": false,
        "showErrors": false,
        "showWarnings": true,
        "unitid": "",
        "dataType": "HoldingRegister",
        "adr": "0",
        "quantity": "1",
        "rate": "1",
        "rateUnit": "s",
        "delayOnStart": true,
        "enableDeformedMessages": false,
        "startDelayTime": "2",
        "server": "8b541492fab04d39",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": false,
        "x": 400,
        "y": 560,
        "wires": [
            [
                "fn_store_hr0_merge"
            ],
            []
        ]
    },
    {
        "id": "fn_store_hr0_merge",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "c8f54098435e95b2",
        "name": "parse HR0",
        "func": "const r = Array.isArray(msg.payload)\n  ? msg.payload\n  : ((msg.responseBuffer && msg.responseBuffer.data) || []);\n\nfunction s16(v) {\n  v = (v || 0) & 0xFFFF;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\nconst equipmentId = 'CNC-01';\nconst value = s16(r[0]);\n\nflow.set('merge_cnc01_hr0', value);\nflow.set('merge_cnc01_hr0_ts', Date.now());\n\nconst hr2 = flow.get('merge_cnc01_hr2');\nif (hr2 === undefined) return null;\n\nmsg.payload = {\n  equipment_id: equipmentId,\n  tags: {\n    spindle_speed_sp: value,\n    spindle_speed: hr2\n  }\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 560,
        "wires": [
            [
                "ced6497cc62e45a9",
                "ef7bd907c18a46d5"
            ]
        ]
    },
    {
        "id": "read_cnc01_hr2_bridge_merge",
        "type": "modbus-read",
        "z": "5b220735e29c459d",
        "g": "c8f54098435e95b2",
        "name": "CNC-01 HR[2] from bridge",
        "topic": "cnc01_hr2",
        "showStatusActivities": false,
        "logIOActivities": false,
        "showErrors": false,
        "showWarnings": true,
        "unitid": "",
        "dataType": "HoldingRegister",
        "adr": "2",
        "quantity": "1",
        "rate": "1",
        "rateUnit": "s",
        "delayOnStart": true,
        "enableDeformedMessages": false,
        "startDelayTime": "2",
        "server": "cfg_local_bridge_15102_merge",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": false,
        "x": 410,
        "y": 600,
        "wires": [
            [
                "fn_store_hr2_merge"
            ],
            []
        ]
    },
    {
        "id": "fn_store_hr2_merge",
        "type": "function",
        "z": "5b220735e29c459d",
        "g": "c8f54098435e95b2",
        "name": "parse HR2",
        "func": "const r = Array.isArray(msg.payload)\n  ? msg.payload\n  : ((msg.responseBuffer && msg.responseBuffer.data) || []);\n\nfunction s16(v) {\n  v = (v || 0) & 0xFFFF;\n  return (v & 0x8000) ? v - 0x10000 : v;\n}\n\nconst equipmentId = 'CNC-01';\nconst value = s16(r[0]);\n\nflow.set('merge_cnc01_hr2', value);\nflow.set('merge_cnc01_hr2_ts', Date.now());\n\nconst hr0 = flow.get('merge_cnc01_hr0');\nif (hr0 === undefined) return null;\n\nmsg.payload = {\n  equipment_id: equipmentId,\n  tags: {\n    spindle_speed_sp: hr0,\n    spindle_speed: value\n  }\n};\nreturn msg;",
