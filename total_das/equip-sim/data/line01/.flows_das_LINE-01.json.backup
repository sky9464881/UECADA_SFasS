    {
        "id": "a53061c7588d45eb",
        "type": "comment",
        "z": "5b220735e29c459d",
        "g": "88c6b4ebe757c21d",
        "name": "CAST-01 (mcprotocol) :5001",
        "info": "LINE-01_CAST-01 @ cast-01:5001",
