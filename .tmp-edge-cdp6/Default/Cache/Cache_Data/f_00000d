function downsampleIndexed(values, maxPoints = 1600) {
  if (!Array.isArray(values) || values.length === 0) return []
  const step = Math.max(1, Math.ceil(values.length / maxPoints))
  const points = []
  for (let i = 0; i < values.length; i += step) {
