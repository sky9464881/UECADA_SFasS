# 백엔드 API (비우면 알람 등은 목업 모드로 동작)
VITE_API_BASE_URL=

# true 이면 알람 API를 호출하지 않고 지연 목업 데이터 사용
VITE_USE_MOCK_ALARMS=true

# SMWP 웹스카다 기본 URL
# 공장 라인: A=LDV_A, B=LDV_B, C=LDV_C
# 공정 상세: 주조=ED_CAST, 가공=ED_CNC, 세척=ED_WASH, 조립=ED_ASSY, 검사=ED_TEST
VITE_SWMP_DEFAULT_URL=http://192.168.0.100:11005/?Pro=myseo_260430#LDV_A

# 참고 URL 목록
# LINE A: http://192.168.0.100:11005/?Pro=myseo_260430#LDV_A
# LINE B: http://192.168.0.100:11005/?Pro=myseo_260430#LDV_B
# LINE C: http://192.168.0.100:11005/?Pro=myseo_260430#LDV_C
# 주조: http://192.168.0.100:11005/?Pro=myseo_260430#ED_CAST
# 가공: http://192.168.0.100:11005/?Pro=myseo_260430#ED_CNC
# 세척: http://192.168.0.100:11005/?Pro=myseo_260430#ED_WASH
# 조립: http://192.168.0.100:11005/?Pro=myseo_260430#ED_ASSY
# 검사: http://192.168.0.100:11005/?Pro=myseo_260430#ED_TEST
