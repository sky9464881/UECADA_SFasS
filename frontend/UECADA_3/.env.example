# 백엔드 API (비우면 알람 등은 목업 모드로 동작)
VITE_API_BASE_URL=

# true 이면 알람 API를 호출하지 않고 지연 목업 데이터 사용
VITE_USE_MOCK_ALARMS=true
VITE_REALTIME_DEMO=true

# SMWP 웹스카다 (?Pro=프로젝트, #뒤=화면 ID). external = SMWP 자동로그인
VITE_SWMP_OPEN_MODE=external
VITE_SWMP_DEFAULT_URL=http://222.108.180.36:11005/?Pro=yhh0518#LDV
# 아래 계정이 있으면 swmp-launch.html 로 자동 로그인 후 LDV 로 이동 (커밋 금지)
VITE_SWMP_USERNAME=
VITE_SWMP_PASSWORD=
