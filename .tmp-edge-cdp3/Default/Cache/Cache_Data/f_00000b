async function refreshFactoryLayout() {
  try {
    const [linesData, equipData] = await Promise.all([
      getLines('FACTORY-01'),
      getEquipments('FACTORY-01'),
    ])

    if (linesData?.length) {
      const statusOrder = { RUNNING: '정상', STANDBY: '대기', ALARM: '경고', MAINTENANCE: '점검' }
      lines.value = linesData.map((l, i) => {
        const total = l.equipmentTotal || 1
        const runPct = Math.round(l.equipmentRunning / total * 100)
        const stopPct = Math.round(l.equipmentAlarm / total * 100)
        const waitPct = Math.max(0, 100 - runPct - stopPct)
        return {
          id: l.lineId.toLowerCase().replace('line-0', 'line-'),
          name: l.lineName,
          area: l.lineId,
          status: statusOrder[l.lineStatus] ?? '정상',
          oee: l.latestOee != null ? Number(l.latestOee) : (91 - i * 3),
          uph: 60,
          equipment: l.equipmentTotal,
          active: l.equipmentRunning,
          alarm: l.openAlarmCount,
          equipStatus: { run: runPct, stop: stopPct, wait: waitPct, stopEnd: runPct + stopPct },
          balance: 85, stations: [85, 87, 83, 86, 82, 84],
          upmh: 400, productivity: 88, upmhPercent: 82, uphPercent: 83,
          routeNote: '주조 → 가공(3) → 세척(2) → 검사(2)',
        }
      })
    }

    if (equipData?.length) {
      const ids = equipData.map(e => e.equipmentCode)
      let statusMap = {}
      try {
        const statuses = await getEquipmentStatus(ids)
        statuses.forEach(s => { statusMap[s.equipId] = s.statusCode })
      } catch (_) {}

      const statusLabel = { RUNNING: '정상', STANDBY: '대기', ALARM: '경고', MAINTENANCE: '점검' }
      const typeShape = { '주조': 'circle', '가공': 'triangle', '세척': 'square', '조립': 'pentagon', '검사': 'star' }

      equipmentNodes.value = equipData.map(e => {
        const lineNum = e.location?.replace('LINE-0', '') ?? '1'
        const lineId = `line-${lineNum}`
        const sc = statusMap[e.equipmentCode] ?? 'RUNNING'
        return {
          id: e.equipmentCode,
          name: e.equipmentName,
          type: `${e.processType ?? ''}기`,
          shapeKind: typeShape[e.processType] ?? 'circle',
          lineId,
          status: statusLabel[sc] ?? '정상',
          main: `${e.equipmentCode} · ${sc}`,
        }
      })
      if (equipmentNodes.value.length && !equipmentNodes.value.some(e => e.id === selectedEquipmentId.value)) {
        selectedEquipmentId.value = equipmentNodes.value[0].id
      }
    }
  } catch (e) {
    console.warn('[FactoryLayout] API 연결 실패, 데모 데이터 표시:', e.message)
  }
}

